# ═══════════════════════════════════════════════════════════
# CastQuest Admin App — Environment Configuration
# ═══════════════════════════════════════════════════════════
# Copy to .env.local: cp apps/admin/.env.example apps/admin/.env.local

# ─────────────────────────────────────────────
# Network
# ─────────────────────────────────────────────
NEXT_PUBLIC_CHAIN_ID=8453
NEXT_PUBLIC_RPC_URL=https://mainnet.base.org

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:4000

# Admin API key — required for all /api/contracts and /api/feature-flags routes
# Used to authenticate admin API route requests — keep this value secret
ADMIN_API_KEY=change-me-to-a-secure-random-value

# Contract deployer private key (hex, without 0x prefix)
ADMIN_PRIVATE_KEY=
